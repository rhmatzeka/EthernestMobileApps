<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- The illustration is a picture of the app, not content: TalkBack reads
         only the title and description below it. -->
    <FrameLayout
        android:id="@+id/artFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:importantForAccessibility="noHideDescendants">

        <View
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_onboarding_glow" />

        <FrameLayout
            android:id="@+id/artHolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false" />
    </FrameLayout>

    <TextView
        android:id="@+id/textSlideTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:breakStrategy="balanced"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.01"
        android:lineSpacingMultiplier="1.08"
        android:textColor="@color/mw_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSlideDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:breakStrategy="balanced"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="5dp"
        android:minLines="3"
        android:textColor="@color/mw_text_secondary"
        android:textSize="15sp" />
</LinearLayout>
